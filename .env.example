# Supabase Configuration
# These variables must be set in Vercel's Environment Variables settings
# AND in your local .env file for local development

# Supabase Project URL (found in Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://wzjvdwgocqzgdrxjvfir.supabase.co

# Supabase Anon/Publishable Key (found in Supabase Dashboard → Settings → API)
# Note: This is also called the "anon key" - they are the same thing
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_abUGDALJxY2_MCfkdgobBw_Y6mEk7u9

# IMPORTANT: Vite only exposes environment variables prefixed with VITE_ to the frontend
# All client-side variables MUST start with VITE_

# Server-side only (NOT exposed to frontend - do NOT prefix with VITE_)
# SUPABASE_SECRET_KEY=your_secret_key_here

# Google Maps API Key (NOT NEEDED - this app only uses Google Maps links, not the API)
# VITE_GOOGLE_MAPS_API_KEY=not_required
